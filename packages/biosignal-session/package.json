{
	"name": "@elata-biosciences/biosignal-session",
	"version": "0.1.0",
	"description": "Local-first, modality-neutral biosignal session recording and interchange",
	"license": "MIT",
	"author": "Elata",
	"repository": {
		"type": "git",
		"url": "https://github.com/Elata-Biosciences/elata-bio-sdk.git",
		"directory": "packages/biosignal-session"
	},
	"homepage": "https://github.com/Elata-Biosciences/elata-bio-sdk#readme",
	"bugs": "https://github.com/Elata-Biosciences/elata-bio-sdk/issues",
	"keywords": ["biosignal", "eeg", "rppg", "arrow", "indexeddb", "opfs"],
	"engines": {
		"node": ">=20"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./arrow": {
			"types": "./dist/arrow.d.ts",
			"import": "./dist/arrow.js"
		},
		"./host": {
			"types": "./dist/host.d.ts",
			"import": "./dist/host.js"
		},
		"./adapters": {
			"types": "./dist/adapters.d.ts",
			"import": "./dist/adapters.js"
		}
	},
	"files": ["dist", "README.md", "CHANGELOG.md", "llms.txt"],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"lint": "pnpm exec biome lint src jest.config.cjs",
		"test": "jest --config ./jest.config.cjs --passWithNoTests",
		"clean": "node ./scripts/clean.mjs",
		"build": "tsc -p tsconfig.json && node ./scripts/fix-dist-import-specifiers.mjs && node ./scripts/verify-dist-esm.mjs",
		"verify:build": "node ../../scripts/verify-package-build.mjs dist/index.js dist/index.d.ts && node ../../scripts/verify-package-build.mjs dist/arrow.js dist/arrow.d.ts && node ../../scripts/verify-package-build.mjs dist/host.js dist/host.d.ts && node ../../scripts/verify-package-build.mjs dist/adapters.js dist/adapters.d.ts",
		"verify:publish": "pnpm run verify:build",
		"prepare:publish": "pnpm run build",
		"prepack": "pnpm run prepare:publish && pnpm run verify:publish"
	},
	"dependencies": {
		"apache-arrow": "21.2.0",
		"fflate": "0.8.3"
	},
	"devDependencies": {
		"@types/jest": "29.5.14",
		"fake-indexeddb": "6.0.0",
		"jest": "29.7.0",
		"jest-environment-jsdom": "29.7.0",
		"ts-jest": "29.4.4",
		"typescript": "5.9.3"
	}
}
